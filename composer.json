{
  "name": "failing/failure",
  "description": "Consumer-agnostic failure contract, runtime inventory, and RFC 9457 integration for Symfony applications.",
  "type": "symfony-bundle",
  "license": "PolyForm-Noncommercial-1.0.0",
  "require": {
    "php": "^8.4",
    "symfony/config": "^8.1",
    "symfony/dependency-injection": "^8.1",
    "symfony/event-dispatcher": "^8.1",
    "symfony/framework-bundle": "^8.1",
    "symfony/http-foundation": "^8.1",
    "symfony/http-kernel": "^8.1"
  },
  "autoload": {"psr-4": {"App\\Failing\\": "src/"}},
  "autoload-dev": {"psr-4": {"App\\Failing\\Tests\\": "tests/"}},
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.95",
    "gating/gate": "dev-master",
    "phpstan/phpstan": "^2.0",
    "phpunit/phpunit": "^12.0"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../Gating",
      "options": {
        "symlink": true,
        "versions": {
          "gating/gate": "dev-master"
        }
      }
    }
  ],
  "scripts": {
    "guard:architecture": ["@php tools/guard/failing-anti-wheel-guard.php"],
    "validate:prod": "composer validate --strict --no-check-all composer.prod.json",
    "cs:check": "@php vendor/bin/php-cs-fixer fix --dry-run --diff",
    "cs:fix": "@php vendor/bin/php-cs-fixer fix",
    "test": "phpunit",
    "test:coverage": [
      "@php -r \"if (!is_dir('var/coverage')) { mkdir('var/coverage', 0777, true); }\"",
      "@php -d xdebug.mode=coverage vendor/bin/phpunit --path-coverage --coverage-text=var/coverage/summary.txt"
    ],
    "phpstan": "@php vendor/bin/phpstan analyse src tests --level=max",
    "gate": "@php vendor/bin/gating check --target=.",
    "quality": ["@cs:check", "@phpstan", "@test", "@gate"],
    "check:failing": ["@validate:prod", "@guard:architecture", "@cs:check", "@phpstan", "@test", "@gate"]
  },
  "config": {"sort-packages": true}
}
